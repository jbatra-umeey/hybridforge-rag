      }
    }
  },
  "components": {
    "schemas": {
      "DocumentInput": {
        "properties": {
          "document_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$",
            "title": "Document Id"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "source": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Source",
            "default": "manual"
          },
          "text": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Text"
          },
          "acl_groups": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Acl Groups"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document_id",
          "title",
          "text"
        ],
        "title": "DocumentInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "QueryInput": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 2,
            "title": "Question"
          },
          "top_k": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 5
          },
          "candidate_k": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 5.0,
            "title": "Candidate K",
            "default": 30
          },
          "mode": {
            "type": "string",
            "pattern": "^(hybrid|lexical|dense)$",
            "title": "Mode",
            "default": "hybrid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "QueryInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}