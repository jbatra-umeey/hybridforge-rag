# Demo defaults. The app does not auto-load this file; compose does, or export explicitly.
RAG_MODE=demo
DEMO_TOKEN=replace-with-a-random-local-token
SQLITE_PATH=data/demo.db

# Production: provision PostgreSQL 17 + pgvector >=0.8, migrate as a separate owner,
# then connect with the non-owner, non-BYPASSRLS rag_app role.
# RAG_MODE=production
# DATABASE_URL=postgresql://rag_app:PASSWORD@db.example.com/hybridforge?sslmode=verify-full
# PGSSLROOTCERT=/run/secrets/db-ca.crt
# OPENAI_API_KEY=...
# PROVIDER_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# GENERATION_MODEL=gpt-4.1-mini
# OIDC_ISSUER=https://identity.example.com/
# OIDC_AUDIENCE=hybridforge-api
# OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# RERANKER=none
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4318
MAX_INFLIGHT=8
REQUESTS_PER_MINUTE=60
MIN_DENSE_SCORE=0.25
